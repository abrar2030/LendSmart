# Dev server port (must differ from the backend, which defaults to 3000)
PORT=3001

# API Configuration
REACT_APP_API_URL=http://localhost:3000/api
REACT_APP_API_BASE_URL=http://localhost:3000/api

# Blockchain Configuration
REACT_APP_LEND_SMART_LOAN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
REACT_APP_BLOCKCHAIN_NETWORK_ID=31337
REACT_APP_BLOCKCHAIN_ENABLED=true

# Application Configuration
REACT_APP_NAME=LendSmart
REACT_APP_ENVIRONMENT=development

# Feature Flags
REACT_APP_ENABLE_WALLET_CONNECT=true
REACT_APP_ENABLE_AI_SCORING=true

# Optional: Analytics and Monitoring
# REACT_APP_GOOGLE_ANALYTICS_ID=
# REACT_APP_SENTRY_DSN=
