# --------------------------------------------------
# Network RPC endpoints and deployer keys
# --------------------------------------------------
# Only needed when deploying/verifying to a live network. Compiling and
# running the local test suite (`npx hardhat test`) works with none of
# this configured.

ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your-project-id
ETHEREUM_PRIVATE_KEY=

SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-project-id
SEPOLIA_PRIVATE_KEY=

POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_PRIVATE_KEY=

ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_PRIVATE_KEY=

# --------------------------------------------------
# Block explorer API keys (for `npx hardhat verify`)
# --------------------------------------------------
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
ARBISCAN_API_KEY=

# --------------------------------------------------
# Optional deployment parameters (scripts/deploy.js)
# --------------------------------------------------
RISK_ASSESSOR_ADDRESS=

# Set to any non-empty value to include a gas usage report when running tests
REPORT_GAS=
